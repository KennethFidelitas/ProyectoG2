@model Sinpe

@{
    ViewData["Title"] = "Registrar Pago SINPE";
}

<h2>Registrar Pago SINPE</h2>

<hr />

<form asp-action="Create" method="post">

    <div class="form-group">
        <label>Teléfono Origen</label>
        <input asp-for="TelefonoOrigen" class="form-control" maxlength="8" required />
    </div>

    <div class="form-group">
        <label>Nombre Origen</label>
        <input asp-for="NombreOrigen" class="form-control" required />
    </div>

    <div class="form-group">
        <label>Teléfono Destinatario</label>
        <input asp-for="TelefonoDestinatario" class="form-control" maxlength="8" required />
    </div>

    <div class="form-group">
        <label>Nombre Destinatario</label>
        <input asp-for="NombreDestinatario" class="form-control" required />
    </div>

    <div class="form-group">
        <label>Monto</label>
        <input asp-for="Monto" type="number" step="0.01" class="form-control" required />
    </div>

    <div class="form-group">
        <label>Descripción</label>
        <input asp-for="Descripcion" class="form-control" maxlength="50" />
    </div>

    <br />

    <button type="submit" class="btn btn-primary">
        Registrar Pago
    </button>

</form>

<br />

@if (!ViewData.ModelState.IsValid)
{
    <div class="alert alert-danger">
        <ul>
            @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
            {
                <li>@error.ErrorMessage</li>
            }
        </ul>
    </div>
}