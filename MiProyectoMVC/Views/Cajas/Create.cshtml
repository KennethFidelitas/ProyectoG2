@model MiProyectoMVC.Models.Caja

@{
    ViewData["Title"] = "Abrir Caja";
}

<h2>Abrir Nueva Caja</h2>
<hr />

<form asp-action="Create" method="post">

    <div class="mb-3">
        <label class="form-label">Comercio</label>

        <select asp-for="ComercioId" asp-items="ViewBag.Comercios" class="form-select">
            <option value="">-- Seleccione un comercio --</option>
        </select>

        <span asp-validation-for="ComercioId" class="text-danger"></span>
    </div>

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert alert-danger">
            <ul>
                @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                {
                    <li>@error.ErrorMessage</li>
                }
            </ul>
        </div>
    }

    <button type="submit" class="btn btn-primary">Abrir Caja</button>

    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>

</form>