@model MiProyectoMVC.Models.Caja

@{
    ViewData["Title"] = "Abrir Caja";
}

<h1 id="tituloCreate">Abrir Nueva Caja</h1>
<hr aria-hidden="true" />

<div class="row">
    <div class="col-md-6">

        <form asp-action="Create"
              method="post"
              novalidate
              role="form"
              aria-labelledby="tituloCreate">

            @Html.AntiForgeryToken()

            @if (!ViewData.ModelState.IsValid)
            {
                <div class="alert alert-danger"
                     role="alert"
                     aria-live="assertive">
                    <ul>
                        @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                        {
                            <li>@error.ErrorMessage</li>
                        }
                    </ul>
                </div>
            }

            <div class="mb-3">
                <label for="ComercioId" class="form-label">Comercio</label>

                <select asp-for="ComercioId"
                        asp-items="ViewBag.Comercios"
                        id="ComercioId"
                        class="form-select"
                        required
                        aria-required="true">
                    <option value="">— Seleccione un comercio —</option>
                </select>

                <span asp-validation-for="ComercioId"
                      class="text-danger"
                      role="alert"></span>
            </div>

            <div class="d-flex gap-2 mt-3">
                <button type="submit"
                        class="btn btn-primary"
                        aria-label="Abrir nueva caja">
                    Abrir Caja
                </button>

                <a asp-action="Index"
                   class="btn btn-secondary"
                   aria-label="Cancelar">
                    Cancelar
                </a>
            </div>

        </form>

    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}