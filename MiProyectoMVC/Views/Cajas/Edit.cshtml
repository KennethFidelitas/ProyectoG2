@model MiProyectoMVC.Models.Caja

@{
    ViewData["Title"] = "Editar Caja";
}

<h2>Editar Caja #@Model.IdCaja</h2>
<hr />

<form asp-action="Edit" method="post">

    <input type="hidden" asp-for="IdCaja" />

    <div class="mb-3">
        <label class="form-label">Comercio</label>

        <select asp-for="ComercioId"
                asp-items="ViewBag.Comercios"
                class="form-select">
        </select>

        <span asp-validation-for="ComercioId" class="text-danger"></span>
    </div>

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert alert-danger">
            <ul>
                @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                {
                    <li>@error.ErrorMessage</li>
                }
            </ul>
        </div>
    }

    <button type="submit" class="btn btn-warning">
        Guardar Cambios
    </button>

    <a asp-action="Index" class="btn btn-secondary">
        Cancelar
    </a>

</form>