@model MiProyectoMVC.Models.Comercio

<h2 id="tituloDetalles">Detalles del Comercio</h2>

<section aria-labelledby="tituloDetalles">

    <dl>

        <dt>Nombre</dt>
        <dd>@Model.Nombre</dd>

        <dt>Dirección</dt>
        <dd>@Model.Direccion</dd>

        <dt>Teléfono</dt>
        <dd>@Model.Telefono</dd>

        <dt>Email</dt>
        <dd>@Model.Email</dd>

    </dl>

</section>