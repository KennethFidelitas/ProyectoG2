@model MiProyectoMVC.Models.Comercio

<h2 id="tituloEliminar">Eliminar Comercio</h2>

<section aria-labelledby="tituloEliminar">

    <h3 id="mensajeConfirmacion">
        ¿Seguro que desea eliminar este comercio?
    </h3>

    <dl>
        <dt>Nombre</dt>
        <dd>@Model.Nombre</dd>
    </dl>

    <form asp-action="Delete"
          method="post"
          aria-describedby="mensajeConfirmacion">

        <input type="hidden" asp-for="IdComercio" />

        <button type="submit"
                class="btn btn-danger"
                aria-label="Confirmar eliminación del comercio @Model.Nombre">
            Eliminar
        </button>

        <a asp-action="Index"
           class="btn btn-secondary"
           aria-label="Cancelar y volver a la lista de comercios">
            Cancelar
        </a>

    </form>

</section>