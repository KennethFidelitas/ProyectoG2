@model IEnumerable<MiProyectoMVC.Models.Comercio>

<h2>Comercios</h2>

<a asp-action="Create" class="btn btn-primary">Nuevo Comercio</a>

<table class="table">
    <thead>
        <tr>
            <th>Nombre</th>
            <th>Dirección</th>
            <th>Teléfono</th>
            <th>Email</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Nombre</td>
                <td>@item.Direccion</td>
                <td>@item.Telefono</td>
                <td>@item.Email</td>
                <td>
                    <a asp-action="Details" asp-route-id="@item.IdComercio">Detalles</a> |
                    <a asp-action="Edit" asp-route-id="@item.IdComercio">Editar</a> |
                    <a asp-action="Delete" asp-route-id="@item.IdComercio">Eliminar</a>
                </td>
            </tr>
        }
    </tbody>
</table>