@model MiProyectoMVC.Models.ConfiguracionComercio

@{
    ViewData["Title"] = "Nueva Configuración";
}

<div style="max-width:520px;">
    <div class="page-header">
        <a asp-action="Index" class="dn-btn dn-btn-secondary dn-btn-sm" style="margin-bottom:1rem;">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 12H5M12 5l-7 7 7 7" /></svg>
            Volver a configuraciones
        </a>
        <div style="display:flex;align-items:center;gap:0.75rem;margin-bottom:0.25rem;">
            <div style="width:36px;height:36px;background:rgba(168,85,247,0.1);border-radius:9px;display:flex;align-items:center;justify-content:center;color:#a855f7;">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="3" /><path d="M19.07 4.93a10 10 0 010 14.14M4.93 4.93a10 10 0 000 14.14" /></svg>
            </div>
            <h1 class="page-title" style="margin:0;">Nueva Configuración</h1>
        </div>
        <p class="page-subtitle">Define el tipo de integración y comisión del comercio.</p>
    </div>

    @if (TempData["Error"] != null)
    {
        <div class="dn-alert dn-alert-danger" role="alert">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10" /><line x1="15" y1="9" x2="9" y2="15" /><line x1="9" y1="9" x2="15" y2="15" /></svg>
            @TempData["Error"]
        </div>
    }

    <div class="dn-card">
        <form asp-action="Crear" method="post">
            @Html.AntiForgeryToken()

            <div class="dn-form-group">
                <label class="dn-label" asp-for="IdComercio">Comercio</label>
                <select asp-for="IdComercio" class="dn-select" required>
                    <option value="">— Seleccione un comercio —</option>
                    @foreach (var comercio in ViewBag.Comercios)
                    {
                        <option value="@comercio.IdComercio">@comercio.Nombre</option>
                    }
                </select>
                <span asp-validation-for="IdComercio" class="dn-validation"></span>
            </div>

            <div class="dn-form-group">
                <label class="dn-label" asp-for="TipoConfiguracion">Tipo de configuración</label>
                <select asp-for="TipoConfiguracion" class="dn-select" required id="tipoSelect">
                    <option value="">— Seleccione —</option>
                    <option value="1">Plataforma</option>
                    <option value="2">Externa</option>
                    <option value="3">Ambas</option>
                </select>
                <span asp-validation-for="TipoConfiguracion" class="dn-validation"></span>
            </div>

            <!-- Descripción dinámica del tipo seleccionado -->
            <div id="tipoDescripcion" style="display:none;margin-top:-0.5rem;margin-bottom:1.25rem;padding:0.75rem 1rem;border-radius:8px;font-size:0.8125rem;border:1px solid var(--border-color);background:var(--bg-surface);color:var(--text-secondary);">
            </div>

            <div class="dn-form-group">
                <label class="dn-label" asp-for="Comision">Comisión (%)</label>
                <div style="position:relative;">
                    <input asp-for="Comision" type="number" step="0.01" min="0" max="100"
                           class="dn-input" style="padding-right:2.5rem;" placeholder="0.00" required />
                    <span style="position:absolute;right:1rem;top:50%;transform:translateY(-50%);color:var(--text-secondary);font-weight:600;">%</span>
                </div>
                <span asp-validation-for="Comision" class="dn-validation"></span>
            </div>

            <div style="display:flex;gap:0.75rem;margin-top:1.75rem;">
                <button type="submit" class="dn-btn dn-btn-primary">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 21H5a2 2 0 01-2-2V5a2 2 0 012-2h11l5 5v14a2 2 0 01-2 2z" /><polyline points="17 21 17 13 7 13 7 21" /></svg>
                    Guardar
                </button>
                <a asp-action="Index" class="dn-btn dn-btn-secondary">Cancelar</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        const descripciones = {
            '1': 'Plataforma: el comercio recibe pagos únicamente a través de esta plataforma.',
            '2': 'Externa: el comercio procesa pagos de forma externa (API). Genera JWT al autenticar.',
            '3': 'Ambas: el comercio opera tanto en plataforma como externamente vía API.'
        };

        document.getElementById('tipoSelect').addEventListener('change', function () {
            const desc = document.getElementById('tipoDescripcion');
            if (this.value && descripciones[this.value]) {
                desc.textContent = descripciones[this.value];
                desc.style.display = 'block';
            } else {
                desc.style.display = 'none';
            }
        });
    </script>
}
