@model MiProyectoMVC.Models.ConfiguracionComercio

@{
    ViewData["Title"] = "Editar Configuración";
}

<div style="max-width:520px;">
    <div class="page-header">
        <a asp-action="Index" class="dn-btn dn-btn-secondary dn-btn-sm" style="margin-bottom:1rem;">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 12H5M12 5l-7 7 7 7" /></svg>
            Volver a configuraciones
        </a>
        <div style="display:flex;align-items:center;gap:0.75rem;margin-bottom:0.25rem;">
            <div style="width:36px;height:36px;background:rgba(245,158,11,0.1);border-radius:9px;display:flex;align-items:center;justify-content:center;color:var(--warning);">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 00-2 2v14a2 2 0 002 2h14a2 2 0 002-2v-7" /><path d="M18.5 2.5a2.121 2.121 0 013 3L12 15l-4 1 1-4 9.5-9.5z" /></svg>
            </div>
            <h1 class="page-title" style="margin:0;">Editar Configuración</h1>
        </div>
        <p class="page-subtitle">Comercio: <strong>@Model.NombreComercio</strong></p>
    </div>

    @if (TempData["Error"] != null)
    {
        <div class="dn-alert dn-alert-danger" role="alert">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10" /><line x1="15" y1="9" x2="9" y2="15" /><line x1="9" y1="9" x2="15" y2="15" /></svg>
            @TempData["Error"]
        </div>
    }

    <!-- Info actual -->
    <div class="dn-card" style="margin-bottom:1rem;padding:1rem 1.25rem;">
        <div style="display:flex;align-items:center;gap:1.5rem;flex-wrap:wrap;">
            <div>
                <div style="font-size:0.72rem;font-weight:600;text-transform:uppercase;letter-spacing:0.05em;color:var(--text-secondary);margin-bottom:0.2rem;">ID Config</div>
                <div style="font-weight:600;color:var(--text-primary);">#@Model.IdConfiguracion</div>
            </div>
            <div>
                <div style="font-size:0.72rem;font-weight:600;text-transform:uppercase;letter-spacing:0.05em;color:var(--text-secondary);margin-bottom:0.2rem;">Comercio</div>
                <div style="font-weight:600;color:var(--text-primary);">@Model.NombreComercio</div>
            </div>
            <div>
                <div style="font-size:0.72rem;font-weight:600;text-transform:uppercase;letter-spacing:0.05em;color:var(--text-secondary);margin-bottom:0.2rem;">Estado actual</div>
                <div>
                    @if (Model.Estado)
                    {
                        <span class="dn-badge dn-badge-green">Activo</span>
                    }
                    else
                    {
                        <span class="dn-badge dn-badge-gray">Inactivo</span>
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="dn-card">
        <form asp-action="Editar" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="IdConfiguracion" />
            <input type="hidden" asp-for="IdComercio" />

            <div class="dn-form-group">
                <label class="dn-label" asp-for="TipoConfiguracion">Tipo de configuración</label>
                <select asp-for="TipoConfiguracion" class="dn-select" id="tipoSelect">
                    <option value="1">Plataforma</option>
                    <option value="2">Externa</option>
                    <option value="3">Ambas</option>
                </select>
                <span asp-validation-for="TipoConfiguracion" class="dn-validation"></span>
            </div>

            <!-- Descripción dinámica -->
            <div id="tipoDescripcion" style="margin-top:-0.5rem;margin-bottom:1.25rem;padding:0.75rem 1rem;border-radius:8px;font-size:0.8125rem;border:1px solid var(--border-color);background:var(--bg-surface);color:var(--text-secondary);">
            </div>

            <div class="dn-form-group">
                <label class="dn-label" asp-for="Comision">Comisión (%)</label>
                <div style="position:relative;">
                    <input asp-for="Comision" type="number" step="0.01" min="0" max="100"
                           class="dn-input" style="padding-right:2.5rem;" required />
                    <span style="position:absolute;right:1rem;top:50%;transform:translateY(-50%);color:var(--text-secondary);font-weight:600;">%</span>
                </div>
                <span asp-validation-for="Comision" class="dn-validation"></span>
            </div>

            <div class="dn-form-group">
                <label class="dn-label" asp-for="Estado">Estado</label>
                <div style="display:flex;gap:1rem;margin-top:0.25rem;">
                    <label class="radio-option" style="display:flex;align-items:center;gap:0.5rem;cursor:pointer;">
                        <input type="radio" asp-for="Estado" value="true"
                               style="accent-color:var(--accent);width:16px;height:16px;" />
                        <span style="font-size:0.9rem;color:var(--text-primary);">Activo</span>
                    </label>
                    <label class="radio-option" style="display:flex;align-items:center;gap:0.5rem;cursor:pointer;">
                        <input type="radio" asp-for="Estado" value="false"
                               style="accent-color:var(--accent);width:16px;height:16px;" />
                        <span style="font-size:0.9rem;color:var(--text-primary);">Inactivo</span>
                    </label>
                </div>
                <span asp-validation-for="Estado" class="dn-validation"></span>
            </div>

            <div style="display:flex;gap:0.75rem;margin-top:1.75rem;">
                <button type="submit" class="dn-btn dn-btn-warning">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 21H5a2 2 0 01-2-2V5a2 2 0 012-2h11l5 5v14a2 2 0 01-2 2z" /><polyline points="17 21 17 13 7 13 7 21" /></svg>
                    Actualizar
                </button>
                <a asp-action="Index" class="dn-btn dn-btn-secondary">Cancelar</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        const descripciones = {
            '1': 'Plataforma: el comercio recibe pagos únicamente a través de esta plataforma.',
            '2': 'Externa: el comercio procesa pagos de forma externa (API). Genera JWT al autenticar.',
            '3': 'Ambas: el comercio opera tanto en plataforma como externamente vía API.'
        };

        function actualizarDescripcion(valor) {
            const desc = document.getElementById('tipoDescripcion');
            desc.textContent = descripciones[valor] ?? '';
        }

        const select = document.getElementById('tipoSelect');
        // Mostrar descripción del valor actual al cargar
        actualizarDescripcion(select.value);
        select.addEventListener('change', function () {
            actualizarDescripcion(this.value);
        });
    </script>
}
