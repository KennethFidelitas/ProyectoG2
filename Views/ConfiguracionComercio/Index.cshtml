@model List<MiProyectoMVC.Models.ConfiguracionComercio>

@{
    ViewData["Title"] = "Configuración de Comercios";
}

<div class="page-header">
    <div style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:1rem;">
        <div>
            <div style="display:flex;align-items:center;gap:0.75rem;margin-bottom:0.25rem;">
                <div style="width:36px;height:36px;background:rgba(168,85,247,0.1);border-radius:9px;display:flex;align-items:center;justify-content:center;color:#a855f7;">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="3" /><path d="M19.07 4.93a10 10 0 010 14.14M4.93 4.93a10 10 0 000 14.14" /><path d="M15.54 8.46a5 5 0 010 7.07M8.46 8.46a5 5 0 000 7.07" /></svg>
                </div>
                <h1 class="page-title" id="tituloConfig" style="margin:0;">Configuración de Comercios</h1>
            </div>
            <p class="page-subtitle">Administra el tipo de configuración y comisiones por comercio.</p>
        </div>
        <a asp-action="Crear" class="dn-btn dn-btn-primary">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19" /><line x1="5" y1="12" x2="19" y2="12" /></svg>
            Nueva configuración
        </a>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="dn-alert dn-alert-success" role="alert">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 11-5.93-9.14" /><polyline points="22 4 12 14.01 9 11.01" /></svg>
        @TempData["Success"]
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="dn-alert dn-alert-danger" role="alert">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10" /><line x1="15" y1="9" x2="9" y2="15" /><line x1="9" y1="9" x2="15" y2="15" /></svg>
        @TempData["Error"]
    </div>
}

<div class="dn-table-wrapper">
    <div style="overflow-x:auto;">
        <table aria-labelledby="tituloConfig">
            <thead>
                <tr>
                    <th>Comercio</th>
                    <th>Tipo</th>
                    <th>Comisión</th>
                    <th>Fecha registro</th>
                    <th>Fecha modificación</th>
                    <th>Estado</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="7" style="text-align:center;padding:3rem;color:var(--text-secondary);">
                            <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" style="display:block;margin:0 auto 0.75rem;opacity:0.4;"><circle cx="12" cy="12" r="3" /><path d="M19.07 4.93a10 10 0 010 14.14M4.93 4.93a10 10 0 000 14.14" /></svg>
                            No hay configuraciones registradas
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td style="font-weight:600;">@item.NombreComercio</td>
                            <td>
                                @{
                                    var (tipoBadge, tipoColor) = item.TipoConfiguracion switch
                                    {
                                        1 => ("dn-badge-blue", "Plataforma"),
                                        2 => ("dn-badge-yellow", "Externa"),
                                        3 => ("dn-badge-green", "Ambas"),
                                        _ => ("dn-badge-gray", item.TipoConfiguracionTexto)
                                    };
                                }
                                <span class="dn-badge @tipoBadge">@tipoColor</span>
                            </td>
                            <td style="font-weight:600;color:var(--success);">
                                @item.Comision.ToString("N2")%
                            </td>
                            <td style="font-size:0.8125rem;color:var(--text-secondary);white-space:nowrap;">
                                @item.FechaDeRegistro.ToString("dd/MM/yyyy HH:mm")
                            </td>
                            <td style="font-size:0.8125rem;color:var(--text-secondary);white-space:nowrap;">
                                @(item.FechaDeModificacion?.ToString("dd/MM/yyyy HH:mm") ?? "—")
                            </td>
                            <td>
                                @if (item.Estado)
                                {
                                    <span class="dn-badge dn-badge-green">
                                        <svg width="7" height="7" viewBox="0 0 8 8" style="margin-right:4px;"><circle cx="4" cy="4" r="4" fill="currentColor" /></svg>
                                        Activo
                                    </span>
                                }
                                else
                                {
                                    <span class="dn-badge dn-badge-gray">Inactivo</span>
                                }
                            </td>
                            <td>
                                <a asp-action="Editar" asp-route-idComercio="@item.IdComercio"
                                       class="dn-btn dn-btn-warning dn-btn-sm">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 00-2 2v14a2 2 0 002 2h14a2 2 0 002-2v-7" /><path d="M18.5 2.5a2.121 2.121 0 013 3L12 15l-4 1 1-4 9.5-9.5z" /></svg>
                                    Editar
                                </a>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
