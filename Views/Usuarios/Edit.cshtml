@model MiProyectoMVC.Models.Usuario

<h2>Editar Usuario</h2>

@if (ViewBag.Error != null)
{
    <div class="alert alert-danger">@ViewBag.Error</div>
}

<form asp-action="Edit" method="post">

    <input type="hidden" asp-for="IdUsuario" />
    <input type="hidden" asp-for="IdComercio" />

    <div class="form-group">
        <label>Nombres</label>
        <input asp-for="Nombres" class="form-control" required />
    </div>

    <div class="form-group">
        <label>Primer Apellido</label>
        <input asp-for="PrimerApellido" class="form-control" required />
    </div>

    <div class="form-group">
        <label>Segundo Apellido</label>
        <input asp-for="SegundoApellido" class="form-control" required />
    </div>

    <div class="form-group">
        <label>Identificación</label>
        <input asp-for="Identificacion" class="form-control" required />
    </div>

    <div class="form-group">
        <label>Correo Electrónico</label>
        <input asp-for="CorreoElectronico" class="form-control" required />
    </div>

    <div class="form-group">
        <label>Estado</label>
        <select asp-for="Estado" class="form-control">
            <option value="true">Activo</option>
            <option value="false">Inactivo</option>
        </select>
    </div>

    <br />

    <button type="submit" class="btn btn-success">Actualizar</button>
    <a asp-action="Index" class="btn btn-secondary">Volver</a>

</form>