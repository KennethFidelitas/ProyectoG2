@model List<MiProyectoMVC.Models.Caja>

@{
    ViewData["Title"] = "Cajas";
}

<div class="page-header">
    <div style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:1rem;">
        <div>
            <div style="display:flex;align-items:center;gap:0.75rem;margin-bottom:0.25rem;">
                <div style="width:36px;height:36px;background:rgba(34,197,94,0.1);border-radius:9px;display:flex;align-items:center;justify-content:center;color:var(--success);">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 3h18a1 1 0 011 1v16a1 1 0 01-1 1H3a1 1 0 01-1-1V4a1 1 0 011-1z" /><path d="M3 9h18" /></svg>
                </div>
                <h1 class="page-title" id="tituloIndex" style="margin:0;">Cajas</h1>
            </div>
            <p class="page-subtitle">Administra las cajas activas y consulta sus SINPE.</p>
        </div>
        <a asp-action="Create" class="dn-btn dn-btn-primary">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19" /><line x1="5" y1="12" x2="19" y2="12" /></svg>
            Abrir nueva caja
        </a>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="dn-alert dn-alert-success" role="alert">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 11-5.93-9.14" /><polyline points="22 4 12 14.01 9 11.01" /></svg>
        @TempData["Success"]
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="dn-alert dn-alert-danger" role="alert">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10" /><line x1="15" y1="9" x2="9" y2="15" /><line x1="9" y1="9" x2="15" y2="15" /></svg>
        @TempData["Error"]
    </div>
}

<div class="dn-table-wrapper">
    <div style="overflow-x:auto;">
        <table>
            <thead>
                <tr>
                    <th>#</th>
                    <th>Comercio</th>
                    <th>Apertura</th>
                    <th>Cierre</th>
                    <th>Estado</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var caja in Model)
                {
                    <tr>
                        <td style="font-weight:600;color:var(--text-secondary);font-size:0.8125rem;">@caja.IdCaja</td>
                        <td style="font-weight:500;">@caja.Comercio?.Nombre</td>
                        <td style="white-space:nowrap;font-size:0.8125rem;color:var(--text-secondary);">
                            @caja.FechaApertura.ToString("dd/MM/yyyy HH:mm")
                        </td>
                        <td style="white-space:nowrap;font-size:0.8125rem;color:var(--text-secondary);">
                            @(caja.FechaCierre?.ToString("dd/MM/yyyy HH:mm") ?? "—")
                        </td>
                        <td>
                            @if (caja.EstaAbierta)
                            {
                                <span class="dn-badge dn-badge-green">
                                    <svg width="8" height="8" viewBox="0 0 8 8" style="margin-right:4px;"><circle cx="4" cy="4" r="4" fill="currentColor" /></svg>
                                    Abierta
                                </span>
                            }
                            else
                            {
                                <span class="dn-badge dn-badge-gray">Cerrada</span>
                            }
                        </td>
                        <td>
                            <div style="display:flex;gap:0.4rem;flex-wrap:wrap;">
                                <button class="dn-btn dn-btn-info dn-btn-sm"
                                        onclick="verSinpes(@caja.IdCaja)">
                                    SINPES
                                </button>
                                <a asp-action="Edit" asp-route-id="@caja.IdCaja" class="dn-btn dn-btn-warning dn-btn-sm">
                                    Editar
                                </a>
                                @if (caja.EstaAbierta)
                                {
                                    <a asp-action="Cerrar" asp-route-id="@caja.IdCaja" class="dn-btn dn-btn-success dn-btn-sm">
                                        Cerrar
                                    </a>
                                }
                                <a asp-action="Delete" asp-route-id="@caja.IdCaja" class="dn-btn dn-btn-danger dn-btn-sm">
                                    Eliminar
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Modal SINPES -->
<div class="modal fade" id="modalSinpes" tabindex="-1" aria-labelledby="modalSinpesLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content" style="background:var(--bg-primary);border:1px solid var(--border-color);border-radius:14px;">
            <div class="modal-header" style="border-bottom:1px solid var(--border-color);padding:1.25rem 1.5rem;">
                <h5 class="modal-title" id="modalSinpesLabel" style="font-weight:600;color:var(--text-primary);">
                    SINPES de la caja
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body" style="padding:1.5rem;">
                <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:1rem;padding:0.875rem 1rem;background:var(--bg-surface);border-radius:10px;border:1px solid var(--border-color);">
                    <span style="font-size:0.875rem;color:var(--text-secondary);">Total recibido:</span>
                    <span id="totalSinpes" style="font-size:1.25rem;font-weight:700;color:var(--success);">₡0.00</span>
                </div>
                <div style="overflow-x:auto;">
                    <table style="width:100%;border-collapse:collapse;">
                        <thead>
                            <tr>
                                <th style="padding:0.75rem 1rem;font-size:0.75rem;font-weight:600;text-transform:uppercase;letter-spacing:0.05em;color:var(--text-secondary);background:var(--bg-surface);border-bottom:1px solid var(--border-color);text-align:left;">ID</th>
                                <th style="padding:0.75rem 1rem;font-size:0.75rem;font-weight:600;text-transform:uppercase;letter-spacing:0.05em;color:var(--text-secondary);background:var(--bg-surface);border-bottom:1px solid var(--border-color);text-align:left;">Origen</th>
                                <th style="padding:0.75rem 1rem;font-size:0.75rem;font-weight:600;text-transform:uppercase;letter-spacing:0.05em;color:var(--text-secondary);background:var(--bg-surface);border-bottom:1px solid var(--border-color);text-align:left;">Destino</th>
                                <th style="padding:0.75rem 1rem;font-size:0.75rem;font-weight:600;text-transform:uppercase;letter-spacing:0.05em;color:var(--text-secondary);background:var(--bg-surface);border-bottom:1px solid var(--border-color);text-align:left;">Monto</th>
                                <th style="padding:0.75rem 1rem;font-size:0.75rem;font-weight:600;text-transform:uppercase;letter-spacing:0.05em;color:var(--text-secondary);background:var(--bg-surface);border-bottom:1px solid var(--border-color);text-align:left;">Fecha</th>
                                <th style="padding:0.75rem 1rem;font-size:0.75rem;font-weight:600;text-transform:uppercase;letter-spacing:0.05em;color:var(--text-secondary);background:var(--bg-surface);border-bottom:1px solid var(--border-color);text-align:left;">Descripción</th>
                            </tr>
                        </thead>
                        <tbody id="tablaSinpes"></tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function verSinpes(idCaja) {
            fetch('/Cajas/ObtenerSinpes?idCaja=' + idCaja)
                .then(res => {
                    if (!res.ok) throw new Error("Error HTTP: " + res.status);
                    return res.json();
                })
                .then(data => {
                    const tabla = document.getElementById("tablaSinpes");
                    const totalLabel = document.getElementById("totalSinpes");
                    tabla.innerHTML = "";

                    if (!data || data.length === 0) {
                        tabla.innerHTML = `<tr><td colspan="6" style="padding:2rem;text-align:center;color:var(--text-secondary);">No hay registros</td></tr>`;
                        totalLabel.innerText = "₡0.00";
                    } else {
                        data.sort((a, b) => new Date(b.fechaDeRegistro) - new Date(a.fechaDeRegistro));
                        let total = 0;
                        data.forEach(s => {
                            total += s.monto;
                            tabla.innerHTML += `
                                <tr>
                                    <td style="padding:0.75rem 1rem;font-size:0.875rem;color:var(--text-secondary);border-bottom:1px solid var(--border-color);">${s.idSinpe}</td>
                                    <td style="padding:0.75rem 1rem;font-size:0.875rem;color:var(--text-primary);border-bottom:1px solid var(--border-color);">${s.nombreOrigen}</td>
                                    <td style="padding:0.75rem 1rem;font-size:0.875rem;color:var(--text-primary);border-bottom:1px solid var(--border-color);">${s.nombreDestinatario}</td>
                                    <td style="padding:0.75rem 1rem;font-size:0.875rem;font-weight:600;color:var(--success);border-bottom:1px solid var(--border-color);">₡${s.monto.toFixed(2)}</td>
                                    <td style="padding:0.75rem 1rem;font-size:0.8125rem;color:var(--text-secondary);border-bottom:1px solid var(--border-color);white-space:nowrap;">${new Date(s.fechaDeRegistro).toLocaleString()}</td>
                                    <td style="padding:0.75rem 1rem;font-size:0.875rem;color:var(--text-secondary);border-bottom:1px solid var(--border-color);">${s.descripcion ?? "—"}</td>
                                </tr>`;
                        });
                        totalLabel.innerText = "₡" + total.toFixed(2);
                    }
                    new bootstrap.Modal(document.getElementById('modalSinpes')).show();
                })
                .catch(err => {
                    console.error("ERROR:", err);
                    alert("Error al cargar los SINPES");
                });
        }
    </script>
}
