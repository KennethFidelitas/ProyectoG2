@model MiProyectoMVC.Models.Caja

@{
    ViewData["Title"] = "Eliminar Caja";
}

<div style="max-width:480px;">
    <div class="page-header">
        <a asp-action="Index" class="dn-btn dn-btn-secondary dn-btn-sm" style="margin-bottom:1rem;">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 12H5M12 5l-7 7 7 7" /></svg>
            Volver a cajas
        </a>
        <h1 class="page-title" id="tituloDelete">Eliminar Caja</h1>
    </div>

    <div class="dn-alert dn-alert-warning">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z" /><line x1="12" y1="9" x2="12" y2="13" /><line x1="12" y1="17" x2="12.01" y2="17" /></svg>
        ¿Está seguro que desea eliminar la caja <strong>#@Model.IdCaja</strong> del comercio <strong>@Model.NombreComercio</strong>?
    </div>

    <div class="dn-card" style="margin-bottom:1.5rem;">
        <dl style="display:grid;grid-template-columns:auto 1fr;gap:0.75rem 1.5rem;align-items:start;">
            <dt style="font-size:0.8125rem;font-weight:600;color:var(--text-secondary);padding-top:2px;">Fecha apertura</dt>
            <dd>@Model.FechaApertura.ToString("dd/MM/yyyy HH:mm")</dd>

            <dt style="font-size:0.8125rem;font-weight:600;color:var(--text-secondary);padding-top:2px;">Estado</dt>
            <dd>
                @if (Model.EstaAbierta)
                {
                    <span class="dn-badge dn-badge-green">Abierta</span>
                }
                else
                {
                    <span class="dn-badge dn-badge-gray">Cerrada</span>
                }
            </dd>
        </dl>
    </div>

    <form asp-action="Delete" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="IdCaja" />

        <div style="display:flex;gap:0.75rem;">
            <button type="submit" class="dn-btn dn-btn-danger">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6" /><path d="M19 6l-1 14a2 2 0 01-2 2H8a2 2 0 01-2-2L5 6" /><path d="M10 11v6M14 11v6" /><path d="M9 6V4a1 1 0 011-1h4a1 1 0 011 1v2" /></svg>
                Sí, eliminar
            </button>
            <a asp-action="Index" class="dn-btn dn-btn-secondary">Cancelar</a>
        </div>
    </form>
</div>
