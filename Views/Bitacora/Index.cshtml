@model List<MiProyectoMVC.Models.BitacoraEvento>

@{
    ViewData["Title"] = "Bitácora";
}

<h2 id="tituloBitacora">Bitácora de Eventos</h2>
<hr />

@if (TempData["Mensaje"] != null)
{
    <div class="alert alert-success">
        @TempData["Mensaje"]
    </div>
}

<table class="table table-striped table-bordered table-hover">

    <thead class="table-dark">
        <tr>
            <th>#</th>
            <th>Tabla</th>
            <th>Tipo</th>
            <th>Fecha</th>
            <th>Descripción</th>
            <th>Error</th>
            <th>Antes</th>
            <th>Después</th>
        </tr>
    </thead>

    <tbody>

        @if (!Model.Any())
        {
            <tr>
                <td colspan="8" class="text-center">
                    No hay eventos registrados
                </td>
            </tr>
        }
        else
        {
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.IdEvento</td>
                    <td>@item.TablaDeEvento</td>
                    <td>@item.TipoDeEvento</td>
                    <td>@item.FechaDeEvento.ToString("dd/MM/yyyy HH:mm")</td>
                    <td>@item.DescripcionDeEvento</td>

                    <td>
                        @if (!string.IsNullOrEmpty(item.StackTrace))
                        {
                            <details>
                                <summary>Ver error</summary>
                                <pre style="max-height:200px; overflow:auto;">
@item.StackTrace
                                </pre>
                            </details>
                        }
                        else
                        {
                            <span>-</span>
                        }
                    </td>

                    <td>@item.DatosAnteriores ?? "-"</td>
                    <td>@item.DatosPosteriores ?? "-"</td>
                </tr>
            }
        }

    </tbody>

</table>