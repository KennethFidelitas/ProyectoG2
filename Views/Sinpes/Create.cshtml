@model MiProyectoMVC.Models.Sinpe

@{
    ViewData["Title"] = "Registrar Pago SINPE";
}

<div style="max-width:560px;">
    <div class="page-header">
        <div style="display:flex;align-items:center;gap:0.75rem;margin-bottom:0.375rem;">
            <div style="width:36px;height:36px;background:var(--accent-light);border-radius:9px;display:flex;align-items:center;justify-content:center;color:var(--accent);">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="5" width="20" height="14" rx="2" /><line x1="2" y1="10" x2="22" y2="10" /></svg>
            </div>
            <h1 class="page-title" id="tituloFormulario" style="margin:0;">Registrar Pago SINPE</h1>
        </div>
        <p class="page-subtitle">Completa los datos para registrar el pago.</p>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="dn-alert dn-alert-success" role="alert">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 11-5.93-9.14" /><polyline points="22 4 12 14.01 9 11.01" /></svg>
            @TempData["Success"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="dn-alert dn-alert-danger" role="alert">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10" /><line x1="15" y1="9" x2="9" y2="15" /><line x1="9" y1="9" x2="15" y2="15" /></svg>
            @TempData["Error"]
        </div>
    }

    <div class="dn-card">
        <form asp-action="Create" method="post">
            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly" class="dn-alert dn-alert-danger"></div>

            <!-- Sección Origen -->
            <div style="margin-bottom:1.5rem;">
                <div style="font-size:0.75rem;font-weight:600;text-transform:uppercase;letter-spacing:0.06em;color:var(--text-secondary);margin-bottom:1rem;display:flex;align-items:center;gap:0.5rem;">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10" /><line x1="12" y1="8" x2="12" y2="12" /><line x1="12" y1="16" x2="12.01" y2="16" /></svg>
                    Datos del origen
                </div>

                <div style="display:grid;grid-template-columns:1fr 1fr;gap:1rem;">
                    <div class="dn-form-group" style="margin:0;">
                        <label class="dn-label" asp-for="TelefonoOrigen">Teléfono origen</label>
                        <input asp-for="TelefonoOrigen" class="dn-input" maxlength="8" placeholder="88888888" required />
                        <span asp-validation-for="TelefonoOrigen" class="dn-validation"></span>
                    </div>
                    <div class="dn-form-group" style="margin:0;">
                        <label class="dn-label" asp-for="NombreOrigen">Nombre del cliente</label>
                        <input asp-for="NombreOrigen" class="dn-input" placeholder="Nombre completo" required />
                        <span asp-validation-for="NombreOrigen" class="dn-validation"></span>
                    </div>
                </div>
            </div>

            <div style="height:1px;background:var(--border-color);margin-bottom:1.5rem;position:relative;">
                <div style="position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);background:var(--bg-primary);padding:0 0.75rem;">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--text-secondary)" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19" /><polyline points="19 12 12 19 5 12" /></svg>
                </div>
            </div>

            <!-- Sección Destinatario -->
            <div style="margin-bottom:1.5rem;">
                <div style="font-size:0.75rem;font-weight:600;text-transform:uppercase;letter-spacing:0.06em;color:var(--text-secondary);margin-bottom:1rem;display:flex;align-items:center;gap:0.5rem;">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2z" /></svg>
                    Datos del destinatario
                </div>

                <div style="display:grid;grid-template-columns:1fr 1fr;gap:1rem;">
                    <div class="dn-form-group" style="margin:0;">
                        <label class="dn-label" asp-for="TelefonoDestinatario">Teléfono destino</label>
                        <input asp-for="TelefonoDestinatario" class="dn-input" maxlength="8" placeholder="88888888" required />
                        <span asp-validation-for="TelefonoDestinatario" class="dn-validation"></span>
                    </div>
                    <div class="dn-form-group" style="margin:0;">
                        <label class="dn-label" asp-for="NombreDestinatario">Nombre del comercio</label>
                        <input asp-for="NombreDestinatario" class="dn-input" placeholder="Nombre del comercio" required />
                        <span asp-validation-for="NombreDestinatario" class="dn-validation"></span>
                    </div>
                </div>
            </div>

            <div style="height:1px;background:var(--border-color);margin-bottom:1.5rem;"></div>

            <!-- Monto y descripción -->
            <div class="dn-form-group">
                <label class="dn-label" asp-for="Monto">Monto</label>
                <div style="position:relative;">
                    <span style="position:absolute;left:1rem;top:50%;transform:translateY(-50%);font-weight:700;color:var(--text-secondary);font-size:1rem;">₡</span>
                    <input asp-for="Monto" type="number" step="0.01" min="1"
                           class="dn-input" style="padding-left:2.25rem;font-size:1.0625rem;font-weight:600;"
                           placeholder="0.00" required />
                </div>
                <span asp-validation-for="Monto" class="dn-validation"></span>
            </div>

            <div class="dn-form-group">
                <label class="dn-label" asp-for="Descripcion">Descripción <span style="color:var(--text-secondary);font-weight:400;">(opcional)</span></label>
                <input asp-for="Descripcion" class="dn-input" maxlength="50" placeholder="Descripción del pago..." />
            </div>

            <div style="display:flex;gap:0.75rem;margin-top:1.75rem;">
                <button type="submit" class="dn-btn dn-btn-primary" style="flex:1;justify-content:center;">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="5" width="20" height="14" rx="2" /><line x1="2" y1="10" x2="22" y2="10" /></svg>
                    Registrar pago
                </button>
                <a asp-action="Index" class="dn-btn dn-btn-secondary">Cancelar</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
