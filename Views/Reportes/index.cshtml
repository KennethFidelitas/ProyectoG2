@model List<MiProyectoMVC.Models.ReporteMensual>

@{
    ViewData["Title"] = "Reportes";
}

<div class="page-header">
    <div style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:1rem;">
        <div>
            <div style="display:flex;align-items:center;gap:0.75rem;margin-bottom:0.25rem;">
                <div style="width:36px;height:36px;background:rgba(168,85,247,0.1);border-radius:9px;display:flex;align-items:center;justify-content:center;color:#a855f7;">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z" /><polyline points="14 2 14 8 20 8" /><line x1="16" y1="13" x2="8" y2="13" /><line x1="16" y1="17" x2="8" y2="17" /></svg>
                </div>
                <h1 class="page-title" style="margin:0;">Reportes Mensuales</h1>
            </div>
            <p class="page-subtitle">Resumen de transacciones y comisiones por comercio.</p>
        </div>

        <form asp-action="Generar" method="post">
            <button type="submit" class="dn-btn dn-btn-primary">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="23 4 23 10 17 10" /><path d="M20.49 15a9 9 0 11-2.12-9.36L23 10" /></svg>
                Generar reportes
            </button>
        </form>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="dn-alert dn-alert-success" role="alert">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 11-5.93-9.14" /><polyline points="22 4 12 14.01 9 11.01" /></svg>
        @TempData["Success"]
    </div>
}

@if (Model != null && Model.Any())
{
    <!-- Summary Cards -->
    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:1rem;margin-bottom:1.5rem;">
        <div class="dn-card" style="padding:1.25rem;">
            <div style="font-size:0.75rem;color:var(--text-secondary);font-weight:500;text-transform:uppercase;letter-spacing:0.05em;margin-bottom:0.5rem;">Total recaudado</div>
            <div style="font-size:1.5rem;font-weight:700;color:var(--success);">₡@Model.Sum(r => r.MontoTotalRecaudado).ToString("N2")</div>
        </div>
        <div class="dn-card" style="padding:1.25rem;">
            <div style="font-size:0.75rem;color:var(--text-secondary);font-weight:500;text-transform:uppercase;letter-spacing:0.05em;margin-bottom:0.5rem;">Total comisiones</div>
            <div style="font-size:1.5rem;font-weight:700;color:var(--accent);">₡@Model.Sum(r => r.MontoTotalDeComision).ToString("N2")</div>
        </div>
        <div class="dn-card" style="padding:1.25rem;">
            <div style="font-size:0.75rem;color:var(--text-secondary);font-weight:500;text-transform:uppercase;letter-spacing:0.05em;margin-bottom:0.5rem;">Total SINPES</div>
            <div style="font-size:1.5rem;font-weight:700;color:var(--text-primary);">@Model.Sum(r => r.CantidadDeSINPES)</div>
        </div>
        <div class="dn-card" style="padding:1.25rem;">
            <div style="font-size:0.75rem;color:var(--text-secondary);font-weight:500;text-transform:uppercase;letter-spacing:0.05em;margin-bottom:0.5rem;">Comercios</div>
            <div style="font-size:1.5rem;font-weight:700;color:var(--text-primary);">@Model.Count</div>
        </div>
    </div>
}

<div class="dn-table-wrapper">
    <div style="overflow-x:auto;">
        <table>
            <thead>
                <tr>
                    <th>Comercio</th>
                    <th>Cajas</th>
                    <th>Monto recaudado</th>
                    <th>Cantidad SINPES</th>
                    <th>Comisión</th>
                    <th>Fecha reporte</th>
                </tr>
            </thead>
            <tbody>
                @if (Model == null || !Model.Any())
                {
                    <tr>
                        <td colspan="6" style="text-align:center;padding:3rem;color:var(--text-secondary);">
                            <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" style="display:block;margin:0 auto 0.75rem;opacity:0.4;"><path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z" /></svg>
                            No hay reportes generados aún. Haz clic en <strong>Generar reportes</strong>.
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var r in Model)
                    {
                        <tr>
                            <td style="font-weight:600;">@r.NombreComercio</td>
                            <td style="text-align:center;">
                                <span class="dn-badge dn-badge-blue">@r.CantidadDeCajas</span>
                            </td>
                            <td style="font-weight:600;color:var(--success);">₡@r.MontoTotalRecaudado.ToString("N2")</td>
                            <td style="text-align:center;font-weight:500;">@r.CantidadDeSINPES</td>
                            <td style="color:var(--accent);font-weight:500;">₡@r.MontoTotalDeComision.ToString("N2")</td>
                            <td style="color:var(--text-secondary);font-size:0.8125rem;white-space:nowrap;">
                                @r.FechaReporte.ToString("dd/MM/yyyy")
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
