@model MiProyectoMVC.Models.Comercio

@{
    ViewData["Title"] = "Crear Comercio";
}

<div style="max-width:520px;">
    <div class="page-header">
        <a asp-action="Index" class="dn-btn dn-btn-secondary dn-btn-sm" style="margin-bottom:1rem;">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 12H5M12 5l-7 7 7 7" /></svg>
            Volver a comercios
        </a>
        <h1 class="page-title" id="tituloCrear">Crear Comercio</h1>
        <p class="page-subtitle">Registra un nuevo comercio en el sistema.</p>
    </div>

    <div class="dn-card">
        <form asp-action="Create" method="post">
            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly" class="dn-alert dn-alert-danger"></div>

            <div class="dn-form-group">
                <label class="dn-label" asp-for="Nombre">Nombre del comercio</label>
                <input asp-for="Nombre" class="dn-input" placeholder="Nombre del comercio" required />
                <span asp-validation-for="Nombre" class="dn-validation"></span>
            </div>

            <div class="dn-form-group">
                <label class="dn-label" asp-for="Direccion">Dirección</label>
                <input asp-for="Direccion" class="dn-input" placeholder="Dirección completa" required />
                <span asp-validation-for="Direccion" class="dn-validation"></span>
            </div>

            <div class="dn-form-group">
                <label class="dn-label" asp-for="Telefono">Teléfono</label>
                <input asp-for="Telefono" class="dn-input" placeholder="88888888" required />
                <span asp-validation-for="Telefono" class="dn-validation"></span>
            </div>

            <div class="dn-form-group">
                <label class="dn-label" asp-for="Email">Correo electrónico</label>
                <input asp-for="Email" type="email" class="dn-input" placeholder="correo@ejemplo.com" />
                <span asp-validation-for="Email" class="dn-validation"></span>
            </div>

            <div style="display:flex;gap:0.75rem;margin-top:1.5rem;">
                <button type="submit" class="dn-btn dn-btn-primary">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 21H5a2 2 0 01-2-2V5a2 2 0 012-2h11l5 5v14a2 2 0 01-2 2z" /><polyline points="17 21 17 13 7 13 7 21" /></svg>
                    Guardar
                </button>
                <a asp-action="Index" class="dn-btn dn-btn-secondary">Cancelar</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
