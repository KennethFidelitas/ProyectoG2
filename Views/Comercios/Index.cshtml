@model IEnumerable<MiProyectoMVC.Models.Comercio>

@{
    ViewData["Title"] = "Comercios";
}

<div class="page-header">
    <div style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:1rem;">
        <div>
            <div style="display:flex;align-items:center;gap:0.75rem;margin-bottom:0.25rem;">
                <div style="width:36px;height:36px;background:rgba(245,158,11,0.1);border-radius:9px;display:flex;align-items:center;justify-content:center;color:var(--warning);">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2z" /><polyline points="9 22 9 12 15 12 15 22" /></svg>
                </div>
                <h1 class="page-title" id="tituloComercios" style="margin:0;">Comercios</h1>
            </div>
            <p class="page-subtitle">Gestiona los comercios registrados en el sistema.</p>
        </div>
        <a asp-action="Create" class="dn-btn dn-btn-primary">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19" /><line x1="5" y1="12" x2="19" y2="12" /></svg>
            Nuevo comercio
        </a>
    </div>
</div>

<div class="dn-table-wrapper">
    <div style="overflow-x:auto;">
        <table>
            <thead>
                <tr>
                    <th>Nombre</th>
                    <th>Dirección</th>
                    <th>Teléfono</th>
                    <th>Email</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="5" style="text-align:center;padding:3rem;color:var(--text-secondary);">
                            <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" style="display:block;margin:0 auto 0.75rem;opacity:0.4;"><path d="M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2z" /></svg>
                            No hay comercios registrados
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td style="font-weight:600;">@item.Nombre</td>
                            <td style="color:var(--text-secondary);font-size:0.875rem;">@item.Direccion</td>
                            <td style="font-size:0.875rem;">@item.Telefono</td>
                            <td style="font-size:0.875rem;color:var(--text-secondary);">@item.Email</td>
                            <td>
                                <div style="display:flex;gap:0.4rem;">
                                    <a asp-action="Details" asp-route-id="@item.IdComercio" class="dn-btn dn-btn-info dn-btn-sm">
                                        Detalles
                                    </a>
                                    <a asp-action="Edit" asp-route-id="@item.IdComercio" class="dn-btn dn-btn-warning dn-btn-sm">
                                        Editar
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@item.IdComercio" class="dn-btn dn-btn-danger dn-btn-sm">
                                        Eliminar
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
