@model MiProyectoMVC.Models.Comercio

@{
    ViewData["Title"] = "Detalles del Comercio";
}

<div style="max-width:520px;">
    <div class="page-header">
        <a asp-action="Index" class="dn-btn dn-btn-secondary dn-btn-sm" style="margin-bottom:1rem;">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 12H5M12 5l-7 7 7 7" /></svg>
            Volver a comercios
        </a>
        <h1 class="page-title">Detalles del Comercio</h1>
    </div>

    <div class="dn-card" style="margin-bottom:1rem;">
        <!-- Header con avatar -->
        <div style="display:flex;align-items:center;gap:1rem;margin-bottom:1.5rem;padding-bottom:1.25rem;border-bottom:1px solid var(--border-color);">
            <div style="width:52px;height:52px;border-radius:12px;background:rgba(245,158,11,0.12);display:flex;align-items:center;justify-content:center;color:var(--warning);font-size:1.375rem;font-weight:700;flex-shrink:0;">
                @Model.Nombre?.Substring(0, 1).ToUpper()
            </div>
            <div>
                <div style="font-size:1.125rem;font-weight:700;color:var(--text-primary);">@Model.Nombre</div>
                <div style="font-size:0.8125rem;color:var(--text-secondary);">@Model.Email</div>
            </div>
        </div>

        <dl style="display:grid;grid-template-columns:auto 1fr;gap:1rem 1.5rem;align-items:start;">
            <dt style="font-size:0.78rem;font-weight:600;color:var(--text-secondary);text-transform:uppercase;letter-spacing:0.04em;padding-top:2px;">Dirección</dt>
            <dd style="color:var(--text-primary);">@Model.Direccion</dd>

            <dt style="font-size:0.78rem;font-weight:600;color:var(--text-secondary);text-transform:uppercase;letter-spacing:0.04em;padding-top:2px;">Teléfono</dt>
            <dd style="color:var(--text-primary);">@Model.Telefono</dd>

            <dt style="font-size:0.78rem;font-weight:600;color:var(--text-secondary);text-transform:uppercase;letter-spacing:0.04em;padding-top:2px;">Correo</dt>
            <dd style="color:var(--text-primary);">@Model.Email</dd>
        </dl>
    </div>

    <div style="display:flex;gap:0.75rem;">
        <a asp-action="Edit" asp-route-id="@Model.IdComercio" class="dn-btn dn-btn-warning">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 00-2 2v14a2 2 0 002 2h14a2 2 0 002-2v-7" /><path d="M18.5 2.5a2.121 2.121 0 013 3L12 15l-4 1 1-4 9.5-9.5z" /></svg>
            Editar
        </a>
        <a asp-action="Index" class="dn-btn dn-btn-secondary">Volver</a>
    </div>
</div>
