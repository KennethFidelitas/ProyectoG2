@model MiProyectoMVC.Models.Comercio

@{
    ViewData["Title"] = "Detalles del Comercio";
}

<h2>Detalles del Comercio</h2>
<hr />

<div class="card" style="max-width:500px;">
    <div class="card-body">

        <p><strong>Nombre:</strong> @Model.Nombre</p>
        <p><strong>Dirección:</strong> @Model.Direccion</p>
        <p><strong>Teléfono:</strong> @Model.Telefono</p>
        <p><strong>Email:</strong> @Model.Email</p>

    </div>
</div>

<br />

<a asp-action="Index" class="btn btn-secondary">
    Volver
</a>